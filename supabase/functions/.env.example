# Optional. Copy to supabase/functions/.env.local (gitignored) and pass it with
#   npx supabase functions serve --env-file supabase/functions/.env.local
#
# By default local runs deliver to Mailpit. A Resend key is only used locally
# when ALLOW_REAL_EMAIL=true, so it cannot email real people by accident.
# RESEND_API_KEY=
# EMAIL_FROM="UWPM <portal@uwproduct.com>"
# ALLOW_REAL_EMAIL=true
